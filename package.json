{
	"name": "miley",
	"version": "1.0.1",
	"private": true,
	"description": "Linear-to-Claude Code bridge agent",
	"packageManager": "pnpm@11.13.1",
	"engines": {
		"node": ">=24 <25",
		"pnpm": "11.13.1"
	},
	"type": "module",
	"scripts": {
		"build": "pnpm -r build",
		"dev": "pnpm -r --parallel dev",
		"test": "pnpm -r test",
		"lint": "biome check",
		"format:safe": "biome check --write",
		"format": "biome check --write --unsafe",
		"test:packages": "pnpm --filter './packages/*' test",
		"test:packages:run": "pnpm --filter './packages/*' test:run",
		"test:apps": "pnpm --filter './apps/*' test",
		"typecheck": "pnpm build && pnpm -r typecheck",
		"prepare": "husky"
	},
	"keywords": [
		"linear",
		"claude",
		"linear-agent",
		"miley",
		"anthropic",
		"ai",
		"agent",
		"monorepo"
	],
	"author": "Edward Hallam",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/edwardhallam/miley"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.1.3",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.6",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@linear/sdk": "60.0.1"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json}": [
			"biome check --write --unsafe"
		]
	}
}
