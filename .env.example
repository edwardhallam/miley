# Required. Anthropic API key used by Claude sessions.
ANTHROPIC_API_KEY=

# Optional. Claude Code OAuth token when using a subscription-backed login.
CLAUDE_CODE_OAUTH_TOKEN=

# Required for Linear API and MCP tool access.
LINEAR_API_KEY=

# Optional. GitHub token for pull request operations.
GITHUB_TOKEN=

# Optional. API key for config update and MCP endpoints.
MILEY_API_KEY=

MILEY_SERVER_PORT=3457
MILEY_INTERNAL_PORT=3458
MILEY_HOST_EXTERNAL=true
MILEY_BASE_URL=https://miley.example.com
MILEY_CLAUDE_SUPERPOWERS_PLUGIN_PATH=
MILEY_LOG_LEVEL=INFO
